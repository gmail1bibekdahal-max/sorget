# Supabase Configuration (Add these in Vercel Project Settings -> Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Calendly Scheduling URL (Optional, defaults to https://calendly.com/sorget/demo)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/demo
